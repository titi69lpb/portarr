DATABASE_PATH=./data/portal.db
SESSION_SECRET=change-me-to-a-random-32-plus-character-string
PLEX_URL=https://plex.example.com
PLEX_SERVER_TOKEN=replace-with-server-owner-token
PLEX_SERVER_NAME=My Plex Server
PLEX_CLIENT_IDENTIFIER=replace-with-a-fixed-uuid-for-this-app
TAUTULLI_URL=https://tautulli.example.com
TAUTULLI_API_KEY=replace-with-tautulli-api-key
SONARR_URL=https://sonarr.example.com
SONARR_API_KEY=replace-with-sonarr-api-key
RADARR_URL=https://radarr.example.com
RADARR_API_KEY=replace-with-radarr-api-key

# Overseerr
OVERSEERR_URL=https://overseerr.example.com
OVERSEERR_API_KEY=replace-with-overseerr-api-key

SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
MAIL_FROM_ADDRESS=replace-with-from-address
MAIL_FROM_NAME=My Plex Server

# Newsletter
NEWSLETTER_CRON_SECRET=change-me-to-a-long-random-value
PUBLIC_BASE_URL=https://portal.example.com

# Optional. Sidebar shortcut links (up to 6, each independently optional).
# A shortcut only appears if its _URL is set. _ICON_URL is optional too — if
# omitted, the shortcut renders as a text-only link. Always set both
# explicitly if you want an icon: the icon path is not guessed from the
# domain (it varies per service — e.g. some serve it at a non-default path).
# SHORTCUT_PLEX_URL=https://plex.example.com
# SHORTCUT_PLEX_ICON_URL=https://plex.example.com/favicon.ico
# SHORTCUT_OVERSEERR_URL=https://overseerr.example.com
# SHORTCUT_OVERSEERR_ICON_URL=https://overseerr.example.com/favicon.ico
# SHORTCUT_TAUTULLI_URL=https://tautulli.example.com
# SHORTCUT_TAUTULLI_ICON_URL=https://tautulli.example.com/favicon.ico
# SHORTCUT_WIZARR_URL=https://wizarr.example.com
# SHORTCUT_WIZARR_ICON_URL=https://wizarr.example.com/favicon.ico
# SHORTCUT_POSTERR_URL=https://posterr.example.com
# SHORTCUT_POSTERR_ICON_URL=https://posterr.example.com/favicon.ico
# SHORTCUT_PLEX_REWIND_URL=https://plex-rewind.example.com
# SHORTCUT_PLEX_REWIND_ICON_URL=https://plex-rewind.example.com/favicon.ico

# Optional. Enables the /files page, the sidebar "Fichiers"/"Files" link, and
# the download route. Absent entirely = feature is hidden, not broken.
# FILES_ROOT_PATH=/mnt/shared-storage
# Optional. Timeout (ms) for filesystem calls against the mount
# (realpath/readdir/stat). Defaults to 5000 if unset.
FS_TIMEOUT_MS=5000

# Optional, only meaningful alongside FILES_ROOT_PATH. Shared secret used to
# sign download URLs when a DOWNLOAD_PROXY_URL is set.
# DOWNLOAD_SIGNING_SECRET=change-me-to-a-long-random-value

# Optional. When set (together with DOWNLOAD_SIGNING_SECRET), file downloads
# redirect to this base URL instead of being served directly by the portal —
# useful for bypassing a slow/tunneled network path to the storage mount.
# When unset, the portal serves the file directly (with Range support).
# DOWNLOAD_PROXY_URL=https://dl.example.com

# Optional. JSON array of storage volumes to show as usage bars on /admin.
# Absent or empty = the Storage section is hidden entirely.
# STORAGE_VOLUMES=[{"name":"Main Storage","path":"/mnt/shared-storage"}]

# Optional. Powers the dashboard's Kuma status badge ("all up" / "N down",
# no per-monitor detail). Both must be set or the badge is simply not shown.
# KUMA_URL=https://kuma.example.com
# KUMA_API_KEY=replace-with-kuma-api-key
